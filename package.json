{
  "name": "yasunobu-homepage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --config wrangler.jsonc",
    "build": "tsc -p src && node .build/build.js",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:html": "html-validate dist/index.html && html-validate dist",
    "test": "node --test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run lint:html && npm run deploy -- --dry-run && npm audit --audit-level=high"
  },
  "dependencies": {
    "hono": "4.13.20"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "html-validate": "11.21.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "wrangler": "4.165.0"
  }
}
