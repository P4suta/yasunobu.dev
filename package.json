{
  "name": "yasunobu-homepage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "lint:html": "html-validate dist/index.html",
    "check": "npm run format:check && npm run typecheck && npm run build && npm run lint:html && npm audit --audit-level=high"
  },
  "dependencies": {
    "astro": "7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "html-validate": "11.21.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.160.0"
  }
}
