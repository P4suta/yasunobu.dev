{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yasunobu-homepage",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
  },
  "routes": [
    {
      "pattern": "sakashita.yasunobu.dev",
      "custom_domain": true,
    },
  ],
}
